# Normalise line endings: keep text files as LF in the repo AND the working tree.
# Unity writes its YAML assets with LF, so this stops Windows' core.autocrlf from
# rewriting them to CRLF and showing every scene/prefab as "modified".
# (Generated assets here are produced by the EchoShift "Build All" editor pipeline.)

* text=auto eol=lf

# --- Source & Unity text (YAML) assets: force LF ---
*.cs         text eol=lf
*.unity      text eol=lf
*.prefab     text eol=lf
*.asset      text eol=lf
*.mat        text eol=lf
*.meta       text eol=lf
*.anim       text eol=lf
*.controller text eol=lf
*.shader     text eol=lf
*.json       text eol=lf
*.md         text eol=lf

# --- Binary assets: never apply text/EOL conversion ---
*.png  binary
*.jpg  binary
*.jpeg binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.fbx  binary
*.dll  binary
